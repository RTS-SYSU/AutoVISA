    {
      "name": "Node Inspector",
      "kind": "card",
      "refersTo": "inspector",
      "description": "The white bordered detail surface accompanying a selected reasoning node.",
      "html": "<aside class=\"ds-inspector\" aria-label=\"所选节点详情\"><div class=\"ds-inspector-head\"><h2>模型条件</h2></div><div class=\"ds-inspector-body\"><div><h3>这一步在做什么</h3><p>查看当前条件与来源。</p></div><button class=\"ds-detail-link\" type=\"button\">回到条件与来源</button></div></aside>",
      "css": ".ds-inspector{border:1px solid var(--line,#dce3ed);border-radius:12px;background:var(--paper,#fff);overflow:hidden;color:var(--ink,#19283f);font-family:\"Segoe UI\",\"Microsoft YaHei UI\",\"Microsoft YaHei\",sans-serif;font-size:14px;line-height:1.6}.ds-inspector-head{padding:16px 18px;border-bottom:1px solid var(--line,#dce3ed)}.ds-inspector-head h2{margin:0;font-size:15px;line-height:1.4;letter-spacing:-.015em}.ds-inspector-body{padding:18px;display:grid;gap:19px}.ds-inspector-body h3{margin:0 0 6px;font-size:12px;line-height:1.5;color:var(--muted,#637187);font-weight:500}.ds-inspector-body p{margin:0;font-size:13px;line-height:1.8}.ds-detail-link{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:9px 0;border:0;border-bottom:1px solid #edf0f5;background:none;text-align:left;font-family:\"Segoe UI\",\"Microsoft YaHei UI\",\"Microsoft YaHei\",sans-serif;font-size:12px;line-height:1.6;color:var(--ink,#19283f);cursor:pointer}.ds-detail-link:focus-visible{outline:3px solid #5275df;outline-offset:3px}"
    },
