      "css": ".ds-field{display:grid;gap:6px;margin-bottom:16px;color:var(--ink,#19283f);font-family:\"Segoe UI\",\"Microsoft YaHei UI\",\"Microsoft YaHei\",sans-serif;line-height:1.6}.ds-field label{font-size:12px;font-weight:600}.ds-field input{min-width:0;border:1px solid #cbd5e4;border-radius:8px;background:var(--paper,#fff);padding:10px 12px;font-family:\"Segoe UI\",\"Microsoft YaHei UI\",\"Microsoft YaHei\",sans-serif;font-size:13px;line-height:1.6;color:var(--ink,#19283f);caret-color:var(--blue,#2945af)}.ds-field input::placeholder{color:#68778c}.ds-field p{margin:0;font-size:12px;color:var(--muted,#637187)}.ds-field input:focus-visible{outline:3px solid #5275df;outline-offset:3px}"
