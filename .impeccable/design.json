      "css": ".ds-icon{width:19px;height:19px;flex:none;stroke:currentColor;fill:none;stroke-width:1.75;stroke-linecap:round;stroke-linejoin:round}.ds-nav{display:grid;gap:5px;background:var(--rail,#edf1f8);font-family:\"Segoe UI\",\"Microsoft YaHei UI\",\"Microsoft YaHei\",sans-serif;font-size:14px;line-height:1.6}.ds-nav a{display:flex;gap:11px;align-items:center;padding:11px 13px;border-radius:9px;text-decoration:none;color:#536178;font-weight:550}.ds-nav a:hover{background:#e2e8f2;color:var(--ink,#19283f)}.ds-nav a[aria-current=page]{background:var(--paper,#fff);color:var(--blue,#2945af);box-shadow:0 3px 9px #25365e07}.ds-nav a:focus-visible{outline:3px solid #5275df;outline-offset:3px}"
