      "html": "<span class=\"ds-badge ds-confirmed\">已核对</span> <span class=\"ds-badge ds-pending\">待确认</span> <span class=\"ds-badge ds-info\">已选 1 项</span>",
      "css": ".ds-badge{display:inline-flex;align-items:center;gap:6px;padding:3px 9px;border-radius:6px;background:#eef1f6;color:#536178;font-family:\"Segoe UI\",\"Microsoft YaHei UI\",\"Microsoft YaHei\",sans-serif;font-size:12px;line-height:1.6;font-weight:600;white-space:nowrap}.ds-confirmed{background:var(--teal-soft,#e8f5ef);color:var(--teal,#14675b)}.ds-pending{background:var(--amber-soft,#fff4dd);color:var(--amber,#855616)}.ds-info{background:var(--blue-soft,#e8edff);color:var(--blue,#2945af)}"
